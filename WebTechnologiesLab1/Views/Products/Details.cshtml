@model WebTechnologiesLab1.Models.Product

@{
    ViewData["Title"] = "Details";
    var imageUrl = string.IsNullOrEmpty(Model.imageUrl) ? "https://placehold.co/600x400?text=No+Image" : Model.imageUrl;
}

<h1 class="display-4 mb-4">Деталі Товару</h1>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card shadow-sm border-0">
            <img src="@imageUrl" class="card-img-top" alt="@Model.name">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h2 class="card-title mb-0">@Html.DisplayFor(model => model.name)</h2>
                        <p class="card-text text-muted">
                            <span class="badge bg-info">@Html.DisplayFor(model => model.Category.Name)</span>
                        </p>
                    </div>
                    <span class="fs-3 fw-bold text-success">@Model.price.ToString("C")</span>
                </div>

                <p class="card-text">
                    @Html.DisplayFor(model => model.description)
                </p>

                <hr>

                <div class="text-center mt-4">
                    <a asp-action="Edit" asp-route-id="@Model?.id" class="btn btn-warning me-2">
                        <i class="bi bi-pencil-square"></i> Змінити
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Повернутися до Списку
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>